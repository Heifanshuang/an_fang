                    Log.d("ApiClient", "鍝嶅簲缁撴灉 - 浼犳劅鍣ㄦ暟閲? " + response.body().getResultObj().size());
                    // 鎵撳嵃姣忎釜浼犳劅鍣ㄧ殑鏁版嵁锛岀壒鍒叧娉ㄦ俯婀垮害浼犳劅鍣?                    for (int i = 0; i < response.body().getResultObj().size(); i++) {
