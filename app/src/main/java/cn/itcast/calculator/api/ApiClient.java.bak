     * @param deviceId 璁惧ID锛堝彲閫夛級
     * @param strategyId 绛栫暐ID锛堝彲閫夛級
     * @param pageSize 鎸囧畾姣忛〉瑕佹樉绀虹殑鏁版嵁涓暟锛岄粯璁?0锛屾渶澶?00
     * @param startDate 璧峰鏃堕棿锛堝彲閫夛紝鍖呮嫭褰撳ぉ锛屾牸寮廦YYY-MM-DD锛?     * @param endDate 缁撴潫鏃堕棿锛堝彲閫夛紝鍖呮嫭褰撳ぉ锛屾牸寮廦YYY-MM-DD锛?     * @param pageIndex 鎸囧畾椤电爜
     * @param callback 鍥炶皟鎺ュ彛
     */
    public static void getStrategyRecords(long projectId, Long deviceId, Long strategyId, Integer pageSize, String startDate, String endDate, Integer pageIndex, StrategyRecordCallback callback) {
        // 鎵撳嵃璇锋眰淇℃伅
        Log.d(TAG, "=== 寮€濮嬫墽琛屾煡璇㈢瓥鐣ユ墽琛岃褰曡姹?===");
        Log.d(TAG, "璇锋眰URL: " + BASE_URL + "/Strategys/Records");
        Log.d(TAG, "璇锋眰鏂规硶: GET");
        
        // 鏋勫缓鏌ヨ鍙傛暟
        java.util.Map<String, String> params = new java.util.HashMap<>();
        params.put("projectId", String.valueOf(projectId));
        
        if (deviceId != null) {
            params.put("deviceId", String.valueOf(deviceId));
        }
        
        if (strategyId != null) {
            params.put("StrategyID", String.valueOf(strategyId));
        }
        
        if (pageSize != null) {
            params.put("PageSize", String.valueOf(pageSize));
        }
        
        if (startDate != null && !startDate.isEmpty()) {
            params.put("StartDate", startDate);
        }
        
        if (endDate != null && !endDate.isEmpty()) {
            params.put("EndDate", endDate);
        }
        
        if (pageIndex != null) {
            params.put("PageIndex", String.valueOf(pageIndex));
        }
        
        Log.d(TAG, "璇锋眰鍙傛暟: " + params);
        
        // 鎵ц璇锋眰
        Call<com.example.myapplication.api.model.StrategyRecordResponse> call = getApiService().getStrategyRecords(params);
        call.enqueue(new Callback<com.example.myapplication.api.model.StrategyRecordResponse>() {
            @Override
            public void onResponse(Call<com.example.myapplication.api.model.StrategyRecordResponse> call, Response<com.example.myapplication.api.model.StrategyRecordResponse> response) {
                // 鎵撳嵃鍝嶅簲淇℃伅
                Log.d(TAG, "=== 鏌ヨ绛栫暐鎵ц璁板綍鍝嶅簲 ===");
                Log.d(TAG, "鍝嶅簲鐘舵€佺爜: " + response.code());
                Log.d(TAG, "鍝嶅簲鐘舵€佹秷鎭? " + response.message());
                Log.d(TAG, "鍝嶅簲鏄惁鎴愬姛: " + response.isSuccessful());
                
                if (response.isSuccessful() && response.body() != null) {
                    Log.d(TAG, "鍝嶅簲鍐呭 - Status: " + response.body().getStatus() + ", StatusCode: " + response.body().getStatusCode() + ", Msg: " + response.body().getMsg());
                    
                    if (response.body().getResultObj() != null) {
                        Log.d(TAG, "鍝嶅簲缁撴灉 - 绛栫暐鎵ц璁板綍鏁伴噺: " + response.body().getResultObj().getPageSet().size() + ", 鎬昏褰曟暟: " + response.body().getResultObj().getRecordCount());
                        // 鎵撳嵃姣忔潯绛栫暐鎵ц璁板綍
                        for (int i = 0; i < response.body().getResultObj().getPageSet().size(); i++) {
                            com.example.myapplication.api.model.StrategyRecordResponse.StrategyRecord record = response.body().getResultObj().getPageSet().get(i);
                            Log.d(TAG, "绛栫暐鎵ц璁板綍 " + (i+1) + " - RecordID: " + record.getRecordId() + ", StrategyId: " + record.getStrategyId() + ", CreateDate: " + record.getCreateDate() + ", Action: " + record.getAction() + ", ConditionCn: " + record.getConditionCn());
                        }
                    }
                    
                    callback.onSuccess(response.body());
                } else {
                    String errorMsg = "鏌ヨ绛栫暐鎵ц璁板綍澶辫触锛? + response.message();
                    Log.e(TAG, "鏌ヨ绛栫暐鎵ц璁板綍澶辫触: " + errorMsg);
                    callback.onFailure(errorMsg);
                }
            }
            
            @Override
            public void onFailure(Call<com.example.myapplication.api.model.StrategyRecordResponse> call, Throwable t) {
                String errorMsg = "缃戠粶閿欒锛? + t.getMessage();
                Log.e(TAG, "鏌ヨ绛栫暐鎵ц璁板綍缃戠粶閿欒: " + errorMsg);
                t.printStackTrace();
                callback.onFailure(errorMsg);
            }
        });
    }
    
