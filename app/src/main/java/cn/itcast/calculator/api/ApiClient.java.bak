    /**
     * 鎺у埗璁惧
     * @param deviceId 璁惧ID
     * @param apiTag 鍛戒护鏍囩
     * @param value 鎺у埗鍊硷紝1鎴?
     * @param callback 鍥炶皟鎺ュ彛
     */
    public static void controlDevice(String deviceId, String apiTag, String value, DeviceDataCallback callback) {
        // 鎵撳嵃璇锋眰淇℃伅
        System.out.println("=== 寮€濮嬫墽琛屾帶鍒惰澶囪姹?===");
        System.out.println("璇锋眰URL: " + BASE_URL + "/Cmds");
        System.out.println("璇锋眰鏂规硶: POST");
        System.out.println("璇锋眰鍙傛暟 - deviceId: " + deviceId + ", apiTag: " + apiTag);
        System.out.println("璇锋眰浣? " + value);
        
        // 灏嗗瓧绗︿覆杞崲涓烘暣鏁帮紝纭繚璇锋眰浣撳彂閫佺函鏁板瓧鑰屼笉鏄甫寮曞彿鐨勫瓧绗︿覆
        // 杩欐槸瑙ｅ喅璁惧鍙兘寮€鍚笉鑳藉叧闂殑鍏抽敭
        int command = Integer.parseInt(value);
        
        // 浣跨敤Retrofit鍙戦€佽姹?        Call<DeviceControlResponse> call = getApiService().controlDevice(deviceId, apiTag, command);
        call.enqueue(new Callback<DeviceControlResponse>() {
            @Override
            public void onResponse(Call<DeviceControlResponse> call, Response<DeviceControlResponse> response) {
                // 鎵撳嵃鍝嶅簲淇℃伅
                System.out.println("=== 鎺у埗璁惧鍝嶅簲 ===");
                System.out.println("鍝嶅簲鐘舵€佺爜: " + response.code());
                System.out.println("鍝嶅簲鐘舵€佹秷鎭? " + response.message());
                System.out.println("鍝嶅簲鏄惁鎴愬姛: " + response.isSuccessful());
                
                try {
                    String responseBody = "";
                    if (response.body() != null) {
                        responseBody = new Gson().toJson(response.body());
                    } else if (response.errorBody() != null) {
                        responseBody = response.errorBody().string();
                    }
                    System.out.println("鍝嶅簲鍐呭: " + responseBody);
                    
                    if (response.isSuccessful() && response.body() != null) {
                        System.out.println("鎺у埗璁惧鎴愬姛锛屽懡浠D: " + response.body().getResultObj() + ", 鍝嶅簲鐘舵€? " + response.body().getStatus());
                        
                        // 鍒涘缓涓€涓狣eviceDataResponse瀵硅薄杩斿洖锛屼繚鎸佹帴鍙ｅ吋瀹规€?                        DeviceDataResponse deviceResponse = new DeviceDataResponse();
                        deviceResponse.setStatus(response.body().getStatus());
                        deviceResponse.setStatusCode(response.body().getStatusCode());
                        deviceResponse.setMsg(response.body().getMsg());
                        callback.onSuccess(deviceResponse);
                    } else {
                        String errorMsg = "鎺у埗璁惧澶辫触锛? + response.message();
                        if (!responseBody.isEmpty()) {
                            errorMsg += "锛屽搷搴斿唴瀹癸細" + responseBody;
                        }
                        System.out.println("鎺у埗璁惧澶辫触: " + errorMsg);
                        callback.onFailure(errorMsg);
                    }
                } catch (IOException e) {
                    String errorMsg = "璇诲彇鍝嶅簲澶辫触锛? + e.getMessage();
                    System.out.println("璇诲彇鍝嶅簲澶辫触: " + errorMsg);
                    e.printStackTrace();
                    callback.onFailure(errorMsg);
                }
            }
            
            @Override
            public void onFailure(Call<DeviceControlResponse> call, Throwable t) {
                String errorMsg = "缃戠粶閿欒锛? + t.getMessage();
                System.out.println("鎺у埗璁惧缃戠粶閿欒: " + errorMsg);
                t.printStackTrace();
                callback.onFailure(errorMsg);
            }
        });
    }
}