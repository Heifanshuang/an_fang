/**
 * 鍛婅鍘嗗彶 Fragment
 * 瀹炵幇鍛婅鍘嗗彶璁板綍鐨勫睍绀恒€佺瓫閫夈€佹悳绱㈠拰璇︽儏鏌ョ湅鍔熻兘
 */
public class AlarmHistoryFragment extends Fragment {
    
    // 鏃ュ織鏍囩
    private static final String TAG = "AlarmHistoryFragment";

    // UI 缁勪欢
    private TableLayout tlAlarmList;
    private Button btnPrevious;
    private Button btnNext;
    private TextView tvCurrentPage;
    private ProgressBar pbLoading; // 鍔犺浇鐘舵€佹寚绀哄櫒
    private TextView tvRefreshStatus; // 鍒锋柊鐘舵€佹枃鏈?    private Button btnManualRefresh; // 鎵嬪姩鍒锋柊鎸夐挳
    private Button btnToggleRefresh; // 鏆傚仠/鎭㈠鍒锋柊鎸夐挳
    private Button btnDeleteCurrentPage; // 鍒犻櫎褰撳墠椤垫寜閽?    
    // 鏁版嵁
    private List<cn.itcast.calculator.api.model.AlarmHistory> alarmList;
    private int currentPage = 1;
    private final int pageSize = 10; // 姣忛〉鏈€澶氭樉绀?10 鏉¤褰?    private int totalCount = 0; // 鎬昏褰曟暟
    private long projectId = 0; // 椤圭洰 ID锛岄粯璁ゅ€间负 0
    private AlarmHistoryManager alarmHistoryManager; // 鍛婅鍘嗗彶鏁版嵁绠＄悊鍣紝鐢ㄤ簬鍏变韩鏁版嵁
    
    // 鑷姩鍒锋柊鐩稿叧
    private Handler refreshHandler; // 鐢ㄤ簬澶勭悊瀹氭椂鍒锋柊鐨?Handler
    private Runnable refreshRunnable; // 瀹氭椂鍒锋柊浠诲姟
    private final long refreshInterval = 5000; // 鍒锋柊闂撮殧锛屽崟浣嶏細姣锛屼粠 3 绉掕皟鏁翠负 5 绉掞紝鍑忓皯鍒锋柊棰戠巼
    private boolean isAutoRefreshEnabled = true; // 鏄惁鍚敤鑷姩鍒锋柊
    private boolean isRefreshing = false; // 褰撳墠鏄惁姝ｅ湪鍒锋柊
    private long lastRefreshTime = 0; // 涓婃鍒锋柊鏃堕棿锛岀敤浜庡閲忔洿鏂?    private boolean isUserInteracting = false; // 鐢ㄦ埛鏄惁姝ｅ湪鎿嶄綔椤甸潰
    
    @Override
    public View onCreateView(LayoutInflater inflater, ViewGroup container, Bundle savedInstanceState) {
        // 鍔犺浇鍛婅鍘嗗彶甯冨眬
        View view = inflater.inflate(R.layout.fragment_alarm_history, container, false);
        
        // 鍒濆鍖栨暟鎹拰瑙嗗浘
        initData();
        initViews(view);
        initListeners();
        
        // 鍒濆鍖栬嚜鍔ㄥ埛鏂版満鍒?        initAutoRefresh();
        
        // 鍔犺浇鐪熷疄鍛婅鏁版嵁
        fetchAlarmData();
        
        return view;
    }
    
    @Override
    public void onDestroyView() {
        super.onDestroyView();
        // 鍋滄鑷姩鍒锋柊锛岄伩鍏嶅唴瀛樻硠婕?        stopAutoRefresh();
        // 绉婚櫎鎵€鏈夊洖璋冨拰娑堟伅锛岀‘淇?Handler 琚纭噴鏀?        if (refreshHandler != null) {
            refreshHandler.removeCallbacksAndMessages(null);
            refreshHandler = null;
        }
    }

    /**
     * 鍒濆鍖栨暟鎹?     */
    private void initData() {
        // 鍒濆鍖栧憡璀﹀巻鍙叉暟鎹鐞嗗櫒
        alarmHistoryManager = AlarmHistoryManager.getInstance(getActivity());
        
        // 娓呯悊宸叉湁鐨勭壒瀹氭潯浠惰褰?        cleanupSpecificConditionRecords();
        
        // 浠庣鐞嗗櫒鑾峰彇鍛婅鍘嗗彶鏁版嵁
        alarmList = alarmHistoryManager.getAllAlarmRecords();
        totalCount = alarmList.size();
        
        // 娉ㄥ唽鍛婅娣诲姞鐩戝惉鍣紝鐢ㄤ簬鍙戦€佺郴缁熼€氱煡
        alarmHistoryManager.setOnAlarmAddedListener(new AlarmHistoryManager.OnAlarmAddedListener() {
            @Override
            public void onAlarmAdded(List<cn.itcast.calculator.api.model.AlarmHistory> newAlarms) {
                // 鍦?UI 绾跨▼涓彂閫佺郴缁熼€氱煡
                getActivity().runOnUiThread(new Runnable() {
                    @Override
                    public void run() {
                        NotificationUtils.sendAlarmNotification(getActivity(), newAlarms);
                    }
                });
            }
        });
    }
    
    /**
     * 娓呯悊宸叉湁鐨勭壒瀹氭潯浠惰褰?     */
    private void cleanupSpecificConditionRecords() {
        Log.d(TAG, "=== 寮€濮嬫竻鐞嗙壒瀹氭潯浠惰褰?===");
        
        // 鑾峰彇鎵€鏈夊憡璀﹁褰?        List<cn.itcast.calculator.api.model.AlarmHistory> allRecords = alarmHistoryManager.getAllAlarmRecords();
        int initialSize = allRecords.size();
        
        // 鍒涘缓鏂板垪琛ㄥ瓨鍌ㄩ渶瑕佷繚鐣欑殑璁板綍
        List<cn.itcast.calculator.api.model.AlarmHistory> filteredRecords = new ArrayList<>();
        
        // 閬嶅巻鎵€鏈夎褰曪紝鍙繚鐣欓潪鐗瑰畾鏉′欢鐨勮褰?        for (cn.itcast.calculator.api.model.AlarmHistory record : allRecords) {
            String alarmMsg = record.getAlarmMsg();
            boolean isSpecificCondition = false;
            
            // 妫€鏌ユ槸鍚︽槸鐗瑰畾鏉′欢鐨勮褰?            if (alarmMsg != null && (alarmMsg.contains("{澶氬悎涓€娓╁害}<=35 and {澶氬悎涓€婀垮害}<=50") || 
                                    alarmMsg.contains("{澶氬悎涓€娓╁害}<=35 and {澶氬悎涓€婀垮害}<=60") || 
                                    alarmMsg.contains("{澶氬悎涓€娓╁害}<=35 and {澶氬悎涓€娓╁害}<=60"))) {
                isSpecificCondition = true;
                Log.d(TAG, "  娓呯悊鐗瑰畾鏉′欢璁板綍锛? + alarmMsg);
            }
            
            // 濡傛灉涓嶆槸鐗瑰畾鏉′欢鐨勮褰曪紝娣诲姞鍒拌繃婊ゅ悗鐨勫垪琛ㄤ腑
            if (!isSpecificCondition) {
                filteredRecords.add(record);
            }
        }
        
        // 濡傛灉鏈夎褰曡娓呯悊锛屾洿鏂板憡璀﹀巻鍙茬鐞嗗櫒涓殑鏁版嵁
        if (filteredRecords.size() < initialSize) {
            Log.d(TAG, "  娓呯悊浜?" + (initialSize - filteredRecords.size()) + " 鏉＄壒瀹氭潯浠惰褰?);
            
            // 娓呯┖鍘熸湁璁板綍
            alarmHistoryManager.clearAllAlarmRecords();
            
            // 娣诲姞杩囨护鍚庣殑璁板綍
            if (!filteredRecords.isEmpty()) {
                alarmHistoryManager.addAlarmRecords(filteredRecords);
            }
            
            Log.d(TAG, "  娓呯悊鍚庡墿浣欒褰曟暟閲忥細" + filteredRecords.size());
        } else {
            Log.d(TAG, "  娌℃湁闇€瑕佹竻鐞嗙殑鐗瑰畾鏉′欢璁板綍");
        }
        
        Log.d(TAG, "=== 鐗瑰畾鏉′欢璁板綍娓呯悊瀹屾垚 ===");
    }
    
    // ... (鍏朵綑浠ｇ爜淇濇寔涓嶅彉锛屽彧鏄皢鍖呭悕浠?com.example.myapplication 鏀逛负 cn.itcast.calculator)
