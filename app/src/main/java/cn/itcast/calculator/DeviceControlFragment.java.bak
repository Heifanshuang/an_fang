package cn.itcast.calculator;

import android.os.Bundle;
import android.util.Log;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ProgressBar;
import android.widget.Switch;
import android.widget.TextView;

import androidx.fragment.app.Fragment;
import androidx.recyclerview.widget.LinearLayoutManager;
import androidx.recyclerview.widget.RecyclerView;

import cn.itcast.calculator.api.ApiClient;
import cn.itcast.calculator.api.model.DeviceDataResponse;
import cn.itcast.calculator.api.model.ProjectListResponse;
import cn.itcast.calculator.api.model.SensorListResponse;
import cn.itcast.calculator.model.DeviceData;

import java.util.ArrayList;
import java.util.List;

/**
 * 璁惧鎺у埗Fragment
 * 鍏ㄩ潰閲嶆瀯锛屼紭鍖栬澶囨暟鎹鐞嗗拰鎺у埗閫昏緫
 */
public class DeviceControlFragment extends Fragment {

    private static final String TAG = "DeviceControlFragment";
    
    // UI缁勪欢
    private RecyclerView rvDevices;
    private ProgressBar progressBar;
    private LinearLayout llError;
    private LinearLayout llEmpty;
    private TextView tvError;
    private TextView tvErrorDetail;
    private Button btnRetry;
    
    // 鏁版嵁鍜岄€傞厤鍣?    private List<DeviceData> deviceList;
    private DeviceControlAdapter deviceAdapter;
    
    // 璁惧绫诲瀷瀹氫箟
    private static final class DeviceType {
        public static final String SMOKE_ALARM = "yanwubai";
        public static final String INTRUSION_ALARM = "lvse";
        public static final String TEMP_HUMIDITY_ALARM = "red";
        public static final String WATER_LEAK_ALARM = "loushuiyellow";
    }
    
    // 璁惧鍚嶇О鏄犲皠
    private static final java.util.Map<String, String> DEVICE_NAME_MAP = new java.util.HashMap<>();
    static {
        DEVICE_NAME_MAP.put(DeviceType.SMOKE_ALARM, "鐑熼浘鎶ヨ鐏?);
        DEVICE_NAME_MAP.put(DeviceType.INTRUSION_ALARM, "闈炴硶闂叆缁跨伅");
        DEVICE_NAME_MAP.put(DeviceType.TEMP_HUMIDITY_ALARM, "娓╂箍搴﹀紓甯告寚绀虹伅");
        DEVICE_NAME_MAP.put(DeviceType.WATER_LEAK_ALARM, "婕忔按鎸囩ず鐏?);
    }
    
    // 璁惧榛樿ID鏄犲皠
    private static final java.util.Map<String, Long> DEVICE_ID_MAP = new java.util.HashMap<>();
    static {
        // 1409883鏄腑蹇冪綉鍏筹紝1409278鏄?G缃戝叧
        DEVICE_ID_MAP.put(DeviceType.SMOKE_ALARM, 1409883L); // 涓績缃戝叧 - 鐑熼浘鎶ヨ鐏?        DEVICE_ID_MAP.put(DeviceType.INTRUSION_ALARM, 1409883L); // 涓績缃戝叧 - 闈炴硶闂叆缁跨伅
        DEVICE_ID_MAP.put(DeviceType.TEMP_HUMIDITY_ALARM, 1409278L); // 4G缃戝叧 - 娓╂箍搴﹀紓甯告寚绀虹伅
        DEVICE_ID_MAP.put(DeviceType.WATER_LEAK_ALARM, 1409278L); // 4G缃戝叧 - 婕忔按鎸囩ず鐏?    }
    
    @Override
    public View onCreateView(LayoutInflater inflater, ViewGroup container, Bundle savedInstanceState) {
        Log.d(TAG, "onCreateView: 寮€濮嬪垱寤鸿鍥?);
        // 鍔犺浇璁惧鎺у埗甯冨眬
        View view = inflater.inflate(R.layout.fragment_device_control, container, false);
        
        // 鍒濆鍖栨暟鎹拰瑙嗗浘
        initData();
        initViews(view);
        
        return view;
    }

    /**
     * 鍒濆鍖栨暟鎹?     */
    private void initData() {
        Log.d(TAG, "initData: 鍒濆鍖栬澶囨暟鎹垪琛?);
        deviceList = new ArrayList<>();
    }

    /**
     * 鍒濆鍖栬鍥?     */
    private void initViews(View view) {
        Log.d(TAG, "initViews: 鍒濆鍖朥I缁勪欢");
        // 鑾峰彇UI缁勪欢
        rvDevices = view.findViewById(R.id.rv_devices);
        progressBar = view.findViewById(R.id.progress_bar);
        llError = view.findViewById(R.id.ll_error);
        llEmpty = view.findViewById(R.id.ll_empty);
        tvError = view.findViewById(R.id.tv_error);
        tvErrorDetail = view.findViewById(R.id.tv_error_detail);
        btnRetry = view.findViewById(R.id.btn_retry);
        
        // 璁剧疆RecyclerView甯冨眬绠＄悊鍣?        LinearLayoutManager layoutManager = new LinearLayoutManager(getActivity());
        rvDevices.setLayoutManager(layoutManager);
        
        // 璁剧疆RecyclerView鏀寔婊氬姩
        rvDevices.setHasFixedSize(true);
        rvDevices.setNestedScrollingEnabled(true);
        
        // 鍒涘缓骞惰缃€傞厤鍣?        deviceAdapter = new DeviceControlAdapter();
        rvDevices.setAdapter(deviceAdapter);
        
        // 璁剧疆閲嶆柊鍔犺浇鎸夐挳鐐瑰嚮浜嬩欢
        btnRetry.setOnClickListener(v -> {
            Log.d(TAG, "onClick: 閲嶆柊鍔犺浇璁惧鏁版嵁");
            fetchDeviceData();
        });
        
        // 鑾峰彇璁惧鏁版嵁
        fetchDeviceData();
    }

    /**
     * 鑾峰彇璁惧鏁版嵁
     */
    public void fetchDeviceData() {
        Log.d(TAG, "fetchDeviceData: 寮€濮嬭幏鍙栬澶囨暟鎹?);
        // 鏄剧ず鍔犺浇鐘舵€?        showLoading();
        
        // 1. 鑾峰彇椤圭洰鍒楄〃
        ApiClient.getProjects(new ApiClient.ProjectListCallback() {
            @Override
            public void onSuccess(ProjectListResponse projectListResponse) {
                Log.d(TAG, "onSuccess: 鑾峰彇椤圭洰鍒楄〃鎴愬姛");
                if (projectListResponse.isSuccess() && projectListResponse.getResultObj() != null && 
                    !projectListResponse.getResultObj().getPageSet().isEmpty()) {
                    // 鑾峰彇绗竴涓」鐩殑ID
                    long projectId = projectListResponse.getResultObj().getPageSet().get(0).getProjectId();
                    Log.d(TAG, "onSuccess: 鑾峰彇鍒伴」鐩甀D: " + projectId);
                    
                    // 2. 浣跨敤椤圭洰ID鑾峰彇椤圭洰涓嬫墍鏈夎澶囩殑浼犳劅鍣ㄥ疄鏃舵暟鎹?                    ApiClient.getProjectSensorsRealTimeData(projectId, new ApiClient.SensorListCallback() {
                        @Override
                        public void onSuccess(SensorListResponse sensorResponse) {
                            Log.d(TAG, "onSuccess: 鑾峰彇浼犳劅鍣ㄦ暟鎹垚鍔?);
                            // 闅愯棌鍔犺浇鐘舵€?                            hideLoading();
                            
                            if (sensorResponse.isSuccess() && sensorResponse.getResultObj() != null) {
                                Log.d(TAG, "onSuccess: 浼犳劅鍣ㄦ暟鎹暟閲? " + sensorResponse.getResultObj().size());
                                // 灏嗕紶鎰熷櫒瀹炴椂鏁版嵁杞崲涓鸿澶囨暟鎹垪琛?                                buildDeviceList(sensorResponse.getResultObj());
                                
                                // 鏇存柊閫傞厤鍣ㄦ暟鎹?                                deviceAdapter.notifyDataSetChanged();
                                
                                // 鏄剧ず鏁版嵁鐘舵€?                                showData();
                            } else {
                                // 鏄剧ず閿欒淇℃伅
                                showErrorState("鑾峰彇浼犳劅鍣ㄦ暟鎹け璐?, sensorResponse.getMsg());
                            }
                        }

                        @Override
                        public void onFailure(String error) {
                            Log.e(TAG, "onFailure: 鑾峰彇浼犳劅鍣ㄦ暟鎹け璐? " + error);
                            // 闅愯棌鍔犺浇鐘舵€?                            hideLoading();
                            
                            // 鏄剧ず閿欒淇℃伅
                            showErrorState("鑾峰彇浼犳劅鍣ㄦ暟鎹け璐?, error);
                        }
                    });
                } else {
                    Log.e(TAG, "onSuccess: 椤圭洰鍒楄〃涓虹┖");
                    // 闅愯棌鍔犺浇鐘舵€?                    hideLoading();
                    showErrorState("鑾峰彇椤圭洰鍒楄〃澶辫触", projectListResponse.getMsg());
                }
            }

            @Override
            public void onFailure(String error) {
                Log.e(TAG, "onFailure: 鑾峰彇椤圭洰鍒楄〃澶辫触: " + error);
                // 闅愯棌鍔犺浇鐘舵€?                hideLoading();
                
                // 鏄剧ず閿欒淇℃伅
                showErrorState("鑾峰彇椤圭洰鍒楄〃澶辫触", error);
            }
        });
    }
    
    /**
     * 鏋勫缓璁惧鍒楄〃
     * @param sensors 浼犳劅鍣ㄥ疄鏃舵暟鎹垪琛?     */
    private void buildDeviceList(List<com.example.myapplication.api.model.Sensor> sensors) {
        Log.d(TAG, "buildDeviceList: 寮€濮嬫瀯寤鸿澶囧垪琛?);
        deviceList.clear();
        
        // 1. 鍒涘缓浼犳劅鍣ㄦ槧灏勶紝鐢ㄤ簬蹇€熸煡鎵?        java.util.Map<String, com.example.myapplication.api.model.Sensor> sensorMap = new java.util.HashMap<>();
        if (sensors != null && !sensors.isEmpty()) {
            for (com.example.myapplication.api.model.Sensor sensor : sensors) {
                String apiTag = sensor.getApiTag();
                sensorMap.put(apiTag, sensor);
                Log.d(TAG, "buildDeviceList: 澶勭悊浼犳劅鍣? ApiTag=" + apiTag + ", DeviceID=" + sensor.getDeviceId() + ", Value=" + sensor.getValue());
            }
        }
        
        // 2. 鍒涘缓鎵€鏈夐渶瑕佺殑璁惧
        String[] allDeviceTypes = {
            DeviceType.SMOKE_ALARM,
            DeviceType.INTRUSION_ALARM,
            DeviceType.TEMP_HUMIDITY_ALARM,
            DeviceType.WATER_LEAK_ALARM
        };
        
        for (String deviceType : allDeviceTypes) {
            createDevice(deviceType, sensorMap);
        }
        
        Log.d(TAG, "buildDeviceList: 璁惧鍒楄〃鏋勫缓瀹屾垚锛岃澶囨暟閲? " + deviceList.size());
        for (int i = 0; i < deviceList.size(); i++) {
            DeviceData device = deviceList.get(i);
            String apiTag = device.getDatas().get(0).getApiTag();
            Log.d(TAG, "buildDeviceList: 璁惧 " + (i+1) + ": Name=" + device.getName() + ", ID=" + device.getDeviceID() + ", ApiTag=" + apiTag + ", Value=" + device.getDatas().get(0).getValue());
        }
    }
    
    /**
     * 鍒涘缓鍗曚釜璁惧
     * @param deviceType 璁惧绫诲瀷锛坅piTag锛?     * @param sensorMap 浼犳劅鍣ㄦ槧灏?     */
    private void createDevice(String deviceType, java.util.Map<String, com.example.myapplication.api.model.Sensor> sensorMap) {
        // 鍒涘缓璁惧瀵硅薄
        DeviceData device = new DeviceData();
        
        // 璁剧疆璁惧鍩烘湰淇℃伅
        device.setName(DEVICE_NAME_MAP.get(deviceType));
        device.setOnline(true);
        device.setDatas(new ArrayList<>());
        
        // 鐩存帴纭紪鐮佽澶嘔D锛岀‘淇濇瘡涓澶囩被鍨嬩娇鐢ㄦ纭殑ID
        long deviceId;
        switch (deviceType) {
            case DeviceType.SMOKE_ALARM:
                deviceId = 1377547L; // 鐑熼浘鎶ヨ鐏?                break;
            case DeviceType.INTRUSION_ALARM:
                deviceId = 1377547L; // 闈炴硶闂叆璀︾ず鐏豢锛堟牴鎹瓵PI鏂囨。锛屾纭瓺eviceId鏄?377547锛?                break;
            case DeviceType.TEMP_HUMIDITY_ALARM:
                deviceId = 1409278L; // 娓╂箍搴﹀紓甯告寚绀虹伅绾紙鏍规嵁API鏂囨。锛屾纭瓺eviceId鏄?409278锛?                break;
            case DeviceType.WATER_LEAK_ALARM:
                deviceId = 1409278L; // 婕忔按鎸囩ず鐏?                break;
            default:
                deviceId = 1377547L; // 榛樿璁惧ID
        }
        device.setDeviceID(deviceId);
        
        // 鍒涘缓浼犳劅鍣ㄦ暟鎹?        DeviceData.SensorData sensorData = new DeviceData.SensorData();
        sensorData.setApiTag(deviceType);
        sensorData.setValue("0");
        sensorData.setRecordTime(getCurrentTime());
        
        // 濡傛灉鏈変紶鎰熷櫒鏁版嵁锛屾洿鏂颁紶鎰熷櫒鍊?        if (sensorMap.containsKey(deviceType)) {
            com.example.myapplication.api.model.Sensor sensor = sensorMap.get(deviceType);
            sensorData.setValue(sensor.getValue());
            sensorData.setRecordTime(sensor.getRecordTime());
        }
        
        // 娣诲姞浼犳劅鍣ㄦ暟鎹埌璁惧
        device.getDatas().add(sensorData);
        
        // 灏嗚澶囨坊鍔犲埌璁惧鍒楄〃
        deviceList.add(device);
    }
    
    /**
     * 鑾峰彇褰撳墠鏃堕棿锛屾牸寮忥細yyyy-MM-dd HH:mm:ss
     */
    private String getCurrentTime() {
        return new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date());
    }
    
    /**
     * 鏄剧ず鍔犺浇鐘舵€?     */
    private void showLoading() {
        Log.d(TAG, "showLoading: 鏄剧ず鍔犺浇鐘舵€?);
        progressBar.setVisibility(View.VISIBLE);
        rvDevices.setVisibility(View.GONE);
        llError.setVisibility(View.GONE);
        llEmpty.setVisibility(View.GONE);
    }
    
    /**
     * 闅愯棌鍔犺浇鐘舵€?     */
    private void hideLoading() {
        Log.d(TAG, "hideLoading: 闅愯棌鍔犺浇鐘舵€?);
        progressBar.setVisibility(View.GONE);
    }
    
    /**
     * 鏄剧ず鏁版嵁鐘舵€?     */
    private void showData() {
        Log.d(TAG, "showData: 鏄剧ず鏁版嵁鐘舵€?);
        rvDevices.setVisibility(View.VISIBLE);
        llError.setVisibility(View.GONE);
        llEmpty.setVisibility(View.GONE);
    }
    
    /**
     * 鏄剧ず閿欒鐘舵€?     */
    private void showErrorState(String title, String detail) {
        Log.e(TAG, "showErrorState: 鏄剧ず閿欒鐘舵€?- 鏍囬: " + title + ", 璇︽儏: " + detail);
        tvError.setText(title);
        tvErrorDetail.setText(detail);
        llError.setVisibility(View.VISIBLE);
        rvDevices.setVisibility(View.GONE);
        llEmpty.setVisibility(View.GONE);
    }
    
    /**
     * 鏄剧ず绌虹姸鎬?     */
    private void showEmptyState() {
        Log.d(TAG, "showEmptyState: 鏄剧ず绌虹姸鎬?);
        llEmpty.setVisibility(View.VISIBLE);
        rvDevices.setVisibility(View.GONE);
        llError.setVisibility(View.GONE);
    }
    
    @Override
    public void onDestroy() {
        Log.d(TAG, "onDestroy: 閿€姣丗ragment");
        super.onDestroy();
    }
    
    /**
     * 璁惧鎺у埗閫傞厤鍣?     * 鍏ㄩ潰閲嶆瀯锛屼紭鍖栬澶囨帶鍒堕€昏緫
     */
    private class DeviceControlAdapter extends RecyclerView.Adapter<DeviceControlAdapter.DeviceViewHolder> {
        
        @Override
        public DeviceViewHolder onCreateViewHolder(ViewGroup parent, int viewType) {
            Log.d(TAG, "onCreateViewHolder: 鍒涘缓璁惧ViewHolder");
            // 鍔犺浇璁惧鎺у埗椤瑰竷灞€
            View view = LayoutInflater.from(parent.getContext())
                    .inflate(R.layout.item_device_control, parent, false);
            return new DeviceViewHolder(view);
        }
        
        @Override
        public void onBindViewHolder(DeviceViewHolder holder, int position) {
            Log.d(TAG, "onBindViewHolder: 缁戝畾璁惧鏁版嵁锛屼綅缃? " + position);
            // 鑾峰彇褰撳墠璁惧鏁版嵁
            DeviceData device = deviceList.get(position);
            
            // 璁剧疆璁惧鍚嶇О锛岄殣钘忚澶嘔D
            holder.tvDeviceName.setText(device.getName());
            holder.tvDeviceId.setVisibility(View.GONE); // 闅愯棌璁惧ID鏄剧ず
            
            // 鍏堢Щ闄や箣鍓嶇殑鐩戝惉鍣紝閬垮厤璁剧疆鍒濆鐘舵€佹椂瑙﹀彂
            holder.switchControl.setOnCheckedChangeListener(null);
            
            // 璁剧疆寮€鍏冲垵濮嬬姸鎬?            boolean isChecked = false;
            if (device.getDatas() != null && !device.getDatas().isEmpty()) {
                DeviceData.SensorData sensorData = device.getDatas().get(0);
                String currentValue = sensorData.getValue().toString();
                // 寮€鍏抽棴鍚堟椂涓?锛屽紑鍚椂涓?
                isChecked = "1".equals(currentValue);
            }
            holder.switchControl.setChecked(isChecked);
            
            // 璁剧疆寮€鍏崇姸鎬佸彉鍖栫洃鍚櫒
            holder.switchControl.setOnCheckedChangeListener((buttonView, checked) -> {
                handleDeviceControl(holder, device, checked);
            });
        }
        
        /**
         * 澶勭悊璁惧鎺у埗
         * @param holder ViewHolder
         * @param device 璁惧鏁版嵁
         * @param isChecked 寮€鍏崇姸鎬?         */
        private void handleDeviceControl(DeviceViewHolder holder, DeviceData device, boolean isChecked) {
            // 闃叉姈鍔ㄦ鏌?            long currentTime = System.currentTimeMillis();
            if (currentTime - holder.lastClickTime < holder.CLICK_INTERVAL) {
                Log.d(TAG, "handleDeviceControl: 闃叉姈鍔紝蹇界暐閲嶅鐐瑰嚮");
                return;
            }
            holder.lastClickTime = currentTime;
            
            // 鑾峰彇鎺у埗鍙傛暟
            String deviceId = String.valueOf(device.getDeviceID());
            String apiTag = device.getDatas().get(0).getApiTag();
            // 鍙彂閫?鎴?浣滀负鎺у埗鎸囦护锛屼笉娣诲姞浠讳綍鍏朵粬鍊?            String value = isChecked ? "1" : "0";
            
            // 璇︾粏妫€鏌ヨ澶囦俊鎭?            Log.d(TAG, "handleDeviceControl: 鎺у埗璁惧璇︽儏 - " + 
                    "Name=" + device.getName() + ", " +
                    "DeviceID=" + deviceId + ", " +
                    "ApiTag=" + apiTag + ", " +
                    "ControlValue=" + value);
            
            // 妫€鏌ヨ澶囨槸鍚﹀湪绾?            if (!device.isOnline()) {
                showToast(device.getName() + "褰撳墠涓嶅湪绾匡紝鏃犳硶鎺у埗");
                // 鎭㈠寮€鍏崇姸鎬侊紝鍥犱负璁惧涓嶅湪绾匡紝鎺у埗鏃犳硶鎵ц
                holder.switchControl.setChecked(!isChecked);
                return;
            }
            
            // 鏄剧ず姝ｅ湪鎺у埗鎻愮ず
            showToast("姝ｅ湪鎺у埗" + device.getName() + "...");
            
            // 绂佺敤寮€鍏筹紝闃叉閲嶅鐐瑰嚮
            holder.switchControl.setEnabled(false);
            
            // 鍙戦€佹帶鍒舵寚浠わ紝鍙紶閫抎eviceId銆乤piTag鍜?/1鍊?            ApiClient.controlDevice(deviceId, apiTag, value, new ApiClient.DeviceDataCallback() {
                @Override
                public void onSuccess(DeviceDataResponse response) {
                    Log.d(TAG, "onSuccess: 鎺у埗璁惧鎴愬姛 - Name=" + device.getName() + ", Response: " + response.getMsg());
                    
                    // 鏇存柊璁惧鏈湴鐘舵€侊紝纭繚鏈湴鐘舵€佷笌杩滅▼涓€鑷?                    updateDeviceState(device, value);
                    
                    // 鏄剧ず鎺у埗鎴愬姛鎻愮ず
                    showToast(device.getName() + "鎺у埗鎴愬姛");
                    
                    // 鍚敤寮€鍏?                    holder.switchControl.setEnabled(true);
                }
                
                @Override
                public void onFailure(String error) {
                    Log.e(TAG, "onFailure: 鎺у埗璁惧澶辫触 - Name=" + device.getName() + ", DeviceID=" + deviceId + ", ApiTag=" + apiTag + ", Error: " + error);
                    
                    // 鎺у埗澶辫触锛屾仮澶嶅紑鍏崇姸鎬?                    holder.switchControl.setChecked(!isChecked);
                    
                    // 鏄剧ず鎺у埗澶辫触鎻愮ず
                    showToast(device.getName() + "鎺у埗澶辫触锛? + error);
                    
                    // 鍚敤寮€鍏?                    holder.switchControl.setEnabled(true);
                }
            });
        }
        
        /**
         * 鏇存柊璁惧鐘舵€?         * @param device 璁惧鏁版嵁
         * @param value 鎺у埗鍊?         */
        private void updateDeviceState(DeviceData device, String value) {
            if (device.getDatas() != null && !device.getDatas().isEmpty()) {
                DeviceData.SensorData sensorData = device.getDatas().get(0);
                sensorData.setValue(value);
                sensorData.setRecordTime(getCurrentTime());
            }
        }
        
        /**
         * 鏄剧ずToast鎻愮ず
         * @param message 鎻愮ず淇℃伅
         */
        private void showToast(String message) {
            if (getActivity() != null) {
                getActivity().runOnUiThread(() -> {
                    android.widget.Toast.makeText(getActivity(), message, android.widget.Toast.LENGTH_SHORT).show();
                });
            }
        }
        
        @Override
        public int getItemCount() {
            int count = deviceList != null ? deviceList.size() : 0;
            Log.d(TAG, "getItemCount: 璁惧鏁伴噺: " + count);
            return count;
        }
        
        /**
         * 璁惧ViewHolder
         */
        class DeviceViewHolder extends RecyclerView.ViewHolder {
            TextView tvDeviceName;
            TextView tvDeviceId;
            Switch switchControl;
            // 闃叉姈鍔ㄦ椂闂存埑锛岃褰曚笂娆＄偣鍑绘椂闂?            private long lastClickTime = 0;
            // 闃叉姈鍔ㄩ棿闅旓紝1绉?            private static final long CLICK_INTERVAL = 1000;
            
            public DeviceViewHolder(View itemView) {
                super(itemView);
                tvDeviceName = itemView.findViewById(R.id.tv_device_name);
                tvDeviceId = itemView.findViewById(R.id.tv_device_id);
                switchControl = itemView.findViewById(R.id.switch_control);
            }
        }
    }
}